# Chave gratuita em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Modelos gratuitos COM tool calling, em ordem de preferência (fallback automático).
# Confira a lista atual em https://openrouter.ai/models (filtre por "tools" e preço grátis).
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Caminho do banco SQLite (padrão: ./cinerocket.db)
CINEROCKET_DB=cinerocket.db

# Opcionais
# DAILY_LIMIT=45        # trava local; a conta gratuita permite 50 req/dia
# MAX_STEPS=5
# MAX_ROWS=50
# QUERY_TIMEOUT_S=120